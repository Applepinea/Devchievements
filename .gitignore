# Rust
/target
**/*.rs.bk

# Node
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*

# Build artifacts
dist/
dist-extension/
**/target/
*.tsbuildinfo

# WXT output (generated per build; never commit)
apps/extension/.output/
apps/extension/.wxt/

# Experiment output directories (regenerable evidence, not source)
**/.out/
**/.crate-cache/
**/.logs/

# Local crates proxy cache + logs (host workaround artifacts)
/.crate-cache/
/.logs/
/.cargo/config.toml
# Spike crates copy the repo cargo config in at build time; never commit it
/scripts/**/.cargo/

# DSH / local toolchain (never commit)
/_toolchain/
/_toolprobe/

# Git behavior experiment scratch
/tests/.scratch/
/scripts/git-experiments/.out/

# SQLite (never commit real user data)
*.db
*.db-wal
*.db-shm
!packages/golden-tests/fixtures/**/*.db

# Browser profiles created during automated verification attempts
**/chrome-profile*/

# End-to-end scratch directories (regenerable)
/scripts/e2e/.crash/
/scripts/e2e/.loop/
/scripts/e2e/.out/
/scripts/e2e/.out2/
/scripts/e2e/.dbg/
/scripts/e2e/.ipc/
/scripts/e2e/.ipc2/
/scripts/e2e/.log-*

# Verification output (regenerable)
/.verify/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Secrets
.env
.env.*
!.env.example
*.pem
*.pfx
