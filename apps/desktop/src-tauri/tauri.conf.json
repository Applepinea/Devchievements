{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Devchievements",
  "version": "0.1.0",
  "identifier": "local.devchievements.companion",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALAPPDATA/devchievements/assets/**"
        ]
      }
    },
    "trayIcon": {
      "iconPath": "icons/tray.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
