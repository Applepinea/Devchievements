{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Devchievements",
  "version": "0.1.0",
  "identifier": "local.devchievements.companion",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALAPPDATA/devchievements/assets/**"
        ]
      }
    },
    "trayIcon": {
      "iconPath": "icons/tray.png",
      "iconAsTemplate": false
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4M0Q4ODZFMUE1QURFNTAKUldSUTNsb2Fib2c5V0IwZmdjK2Nka21tR0JMVGZRd2RxbndPNExJSWRiR0NZVTZiNGFPRkd2TUYK",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../../../target/release/devch-helper.exe": "./devch-helper.exe",
      "../assets/sounds/*.wav": "sounds/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    }
  }
}
